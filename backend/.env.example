DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mail

SMTP_HOST=smtp-pulse.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM_EMAIL=newsletter@fma.org.ma
MAIL_FROM_NAME="Mailler Studio"
DEFAULT_BATCH_SIZE=20
DEFAULT_PAUSE_SECONDS=120

# Adresses d'expéditeur autorisées (séparées par des virgules), modifiables ensuite dans Paramètres
MAIL_SENDERS=newsletter@fma.org.ma,inscription@rdvdelassurance.ma

# Clé d'installation (création du premier administrateur) et jeton de service pour les scripts (accès admin).
# Les utilisateurs se connectent avec leur e-mail et leur mot de passe.
API_TOKEN=

# Clé de signature des sessions (facultatif : générée dans data/auth-secret si vide)
AUTH_SECRET=
